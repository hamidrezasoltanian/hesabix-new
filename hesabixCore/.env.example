###############################################################################
# Hesabix — Environment Configuration Template
# Copy this file to .env and fill in the values for your server.
###############################################################################

###> symfony/framework-bundle ###
APP_ENV=prod

# Generate a random secret:  php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Replace DB_USER, DB_PASSWORD, DB_HOST, DB_NAME with your actual values.
# For MySQL 8:   serverVersion=8.0.32
# For MariaDB:   serverVersion=10.11.2-MariaDB
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# sync:// is safe for shared hosting (no background worker needed)
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
# Use sendmail (default on most shared hosts):
MAILER_DSN=sendmail://default
# Or SMTP:
# MAILER_DSN=smtp://USERNAME:PASSWORD@smtp.yourdomain.com:587
###< symfony/mailer ###

###> nelmio/cors-bundle ###
# Set to your actual domain as a regex.  Examples:
#   Same-domain (no CORS needed):  ^https?://yourdomain\.com$
#   Allow subdomain:               ^https?://(app\.)?yourdomain\.com$
#   Local dev only:                ^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
CORS_ALLOW_ORIGIN='^https?://yourdomain\.com$'
###< nelmio/cors-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
