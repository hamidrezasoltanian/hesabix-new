###> symfony/framework-bundle ###
APP_ENV=prod
# IMPORTANT: Change this to a random 32-character string before deploying!
# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Set your actual database credentials here.
# For MySQL 8: serverVersion=8.0.32
# For MariaDB: serverVersion=10.11.2-MariaDB
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# sync:// processes messages immediately inline — safe for shared hosting (no workers needed)
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
# For shared hosting use sendmail or SMTP:
# MAILER_DSN=sendmail://default
# MAILER_DSN=smtp://user:password@smtp.example.com:587
MAILER_DSN=sendmail://default
###< symfony/mailer ###

###> nelmio/cors-bundle ###
# Set to your actual domain (e.g. https://yourdomain.com) in production
# Use '*' only for local development
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
